{
  "name": "chronicler",
  "productName": "Chronicler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "dev.kibb.chronicler",
    "productName": "Chronicler",
    "electronVersion": "43.4.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/target/release/chronicler-backend",
        "to": "chronicler-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "dompurify": "^3.4.14",
    "lucide-solid": "^1.33.0",
    "marked": "^18.0.11",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "chokidar": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-solid": "^2.11.13"
  },
  "description": "The IDE of fiction writing",
  "author": "kibb"
}
