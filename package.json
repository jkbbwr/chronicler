{
  "name": "chronicler-workspace",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "scripts": {
    "dev": "cd frontend && bun run dev",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml --release",
    "build:frontend": "bun --cwd frontend run build",
    "build": "bun run build:backend && bun run build:frontend",
    "package": "bun run build:backend && cd frontend && bun run package",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "test:unit": "cd frontend && bun test tests/",
    "test": "bun run test:backend && bun run test:unit",
    "dist": "bun run build:backend && cd frontend && bun run dist",
    "build:backend:linux": "./scripts/build-linux.sh --backend-only",
    "dist:linux": "./scripts/build-linux.sh",
    "dist:linux:x64": "./scripts/build-linux.sh --arch x64",
    "dist:linux:arm64": "./scripts/build-linux.sh --arch arm64"
  },
  "workspaces": [
    "frontend"
  ]
}
